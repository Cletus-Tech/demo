# Copy this file to ".env" ONLY if you want to use `npm run config` (optional).
# Beginners can skip this and edit app/js/config.js directly instead.
#
# Both values are PUBLIC by design (they end up in the browser).
# NEVER put a service_role key, a "secret" key, or your database password here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
